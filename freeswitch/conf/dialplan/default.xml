<include>
  <context name="default">
    <extension name="echo">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <extension name="bridge_to_user">
      <condition field="destination_number" expression="^(alice|bob)$">
        <action application="bridge" data="sofia/internal/$1@kamailio"/>
      </condition>
    </extension>

    <extension name="bridge_to_pstn">
      <condition field="destination_number" expression="^(\+?\d{8,15})$">
        <action application="bridge" data="sofia/gateway/itsp/$1"/>
      </condition>
    </extension>
  </context>
</include>
