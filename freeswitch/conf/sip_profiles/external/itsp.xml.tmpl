<include>
  <gateway name="itsp">
    <param name="proxy" value="@@ITSP_PROXY@@"/>
    <param name="username" value="@@ITSP_USER@@"/>
    <param name="password" value="@@ITSP_PASS@@"/>
    <param name="realm" value="@@ITSP_REALM@@"/>
    <param name="from-domain" value="@@ITSP_REALM@@"/>
    <param name="register" value="false"/>
    <param name="caller-id-in-from" value="true"/>
  </gateway>
</include>
